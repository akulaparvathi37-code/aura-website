# ==============================================================================
# AURA LUXURY ATELIER — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' or '.env.local' on your local development machine.
# 2. Fill in the appropriate keys and endpoints for your environment.
# 3. NEVER commit real secret values, keys, or .env files to Git or GitHub.
# ==============================================================================

# Supabase Project Configuration (Client-safe anon key and project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Next.js Compatibility Variables (if using Next.js runtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Razorpay Payment Gateway Configuration (Public Key ID for client checkout)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Server-side Secrets (Used by Supabase Edge Functions & server middleware; NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your_server_service_role_key_here
# RAZORPAY_KEY_ID=rzp_test_your_key_id_here
# RAZORPAY_KEY_SECRET=your_server_razorpay_secret_here
